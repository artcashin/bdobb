# Copy to .env. Everything here is optional.

# Your tailnet name for this node, so the guard answers for it (tailnet profile only).
# LIBRE_GUARD_EXTRA_HOSTS=libre.your-tailnet.ts.net

# Origins the guard admits. The default covers installed BDOBB apps; a dev build needs its own.
# LIBRE_GUARD_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420

# A shared secret. In BDOBB's Connection, set header name X-Libre-Token and this value.
# LIBRE_GUARD_TOKEN=

# Free API keys for more U.S. data (FRED, EIA, BLS, Congress.gov). Copy api_keys.example.env to
# api_keys.env, fill it in, and point this at it.
# LIBRE_API_KEYS_FILE=./api_keys.env

# Host ports, and the base image (use a mirror if Docker Hub rate-limits you).
# LIBRE_DATA_PORT=7900
# LIBRE_VIEWS_PORT=7950
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim
