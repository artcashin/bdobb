# Copy to .env.local (gitignored) and fill in your own endpoints.
# These seed a fresh install only — once Backends/Settings are edited in the
# app, the persisted values win.

# OpenBB Platform API serving widgets.json
VITE_OPENBB_API_URL=https://openbb-api.example.ts.net

# Agent Rita (OpenBB custom-agent protocol)
VITE_RITA_URL=https://openbb-rita.example.ts.net

# MCP servers, comma-separated id=url pairs
VITE_MCP_SERVERS=openbb=https://openbb-api.example.ts.net:8443/mcp,stores=https://openbb-api.example.ts.net:8444/mcp

# Where a Rita conversation goes when you "Send to…".
#
# The point of a share target is that an exchange with the analyst does not
# evaporate when the pane closes: the conversation is exported so it can be
# kept, searched and cited later, next to the rest of your notes. Targets are
# configured in Settings and come in three kinds — `mcp` and `http` reach a
# service (Notion, a webhook), while `file` writes markdown into a directory,
# which is how the filesystem-backed vaults (Tolaria, Obsidian) are fed.
#
# This variable is ONLY about the `file` kind. It lists the directories such a
# target is permitted to write into: comma-separated, and each one absolute,
# because it is compiled into the Tauri fs scope. `pnpm dev` is permissive and
# will happily write outside it — a PACKAGED build refuses, so a share target
# that works in dev can fail silently in a release if its folder is missing
# here.
#
# It is per-machine (an absolute path under your own home directory), so keep
# it in .env.local. Setting it as a CI/repository variable would bake one
# user's home path into every published binary, where it is both wrong for
# everyone else and more than a release should disclose.
VITE_SHARE_FOLDERS=/Users/you/Vault/OpenBB-Rita

# Optional: only used by the opt-in live integration suite
# (OPENBB_LIVE=1 pnpm test:run src/test/integration)
OPENBB_LIVE=
OPENBB_NAS_URL=
OPENBB_RITA_URL=
OPENBB_MCP_URLS=

# ---------------------------------------------------------------------------
# Test environment — needs no deployment of your own
# ---------------------------------------------------------------------------
# OpenBB publishes a reference backend serving ~70 widgets that cover most of
# the spec. Run it locally and point Desk at it:
#
#   pnpm reference-backend      # clones, installs and serves on :7779
#   pnpm test:reference         # conformance suite against it
#
# To make it Desk's default backend, use this instead of the tailnet URL above.
# It must also be in the Tauri HTTP capability scope, which is generated from
# this file — so setting it here is what makes a packaged build able to reach
# it, not just `pnpm dev`.
#
#   VITE_OPENBB_API_URL=http://127.0.0.1:7779
#
# Optional override for the conformance suite's target:
OPENBB_REFERENCE_URL=

# ---------------------------------------------------------------------------
# iPadOS signing
# ---------------------------------------------------------------------------
# Apple team id, needed only to run on a PHYSICAL iPad — the simulator runs
# unsigned. It identifies your developer account, so it lives here rather than
# in the committed tauri.conf.json.
#
#   1. Xcode > Settings > Accounts > + > Apple ID.  A free Apple ID is enough:
#      it creates a "Personal Team" that can sign for your own devices.
#   2. pnpm ios:team      # prints the id
#   3. paste it below
APPLE_DEVELOPMENT_TEAM=

