# Copy to .env.local (gitignored) and fill in your own endpoints.
# These seed a fresh install only — once Backends are edited in the app, the
# persisted values win.
#
# The Tauri HTTP capability allowlist is GENERATED from this file, so setting
# the URL here is also what lets a packaged build reach the backend at all —
# `pnpm dev` is more permissive and will hide the omission until you build.

# OpenBB Platform API serving widgets.json (Episode 1's stack)
VITE_OPENBB_API_URL=https://openbb.example.ts.net

# ---------------------------------------------------------------------------
# Test environment — needs no deployment of your own (v5.0.0, Ep. 5)
# ---------------------------------------------------------------------------
# OpenBB publishes a reference backend serving ~70 widgets. Run it locally:
#
#   pnpm reference-backend      # clones, installs and serves on :7779
#   pnpm test:reference         # conformance suite against it
#
# To make it BDOBB's default backend (and put it in the generated capability
# scope, which is what lets a PACKAGED build reach it):
#
#   VITE_OPENBB_API_URL=http://127.0.0.1:7779
#
# Optional override for the conformance suite's target:
OPENBB_REFERENCE_URL=
