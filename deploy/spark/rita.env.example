# Agent Rita on the Spark — deploy as /home/dev/rita/rita.env (chmod 600).
# Real values NEVER enter git. Sources:
#   OPENAI_API_KEY   = SPARK_KEY_RITA from the Mac's ~/.zshenv (a line in the
#                      Spark's /root/keys/qwen.keys; llama.cpp --api-key-file)
#   <SPARK_TS_IP>    = `tailscale ip -4` on <agent-host> (currently <llm-host-tailnet-ip>)
#   <MODEL_ID>       = curl -s http://<SPARK_TS_IP>:8000/v1/models | jq -r '.data[0].id'
#                      (currently qwen3-coder)
OPENAI_API_KEY=<SPARK_KEY_RITA>
OPENAI_BASE_URL=http://<SPARK_TS_IP>:8000/v1
DEFAULT_MODEL=openai:<MODEL_ID>
PORT=8002
